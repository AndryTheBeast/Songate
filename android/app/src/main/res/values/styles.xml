<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full screen from the first frame, black under it, drawn under the camera's cut-outs on every Android: the app keeps its
         pieces clear of them as Settings › Appearance › Screen edges says (Android 10: the short edges; values-v30: every edge) -->
    <style name="Songate" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
