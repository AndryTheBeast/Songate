<?xml version="1.0" encoding="utf-8"?>
<!-- Songate for Android: SDL's activity (SongateActivity) in landscape for now; portrait comes with its own layout. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- The music: All files access (Android 11 and later); Android 10 reads and writes the shared volumes with these -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Devices, Listen together, AirPlay, Last.fm, Updates -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- listening together: the delay, measured with the chirps (micmeasure.hpp); asked for the first time it is needed -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Music out of sight: SongateService, with the system's music controls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Settings › Updates: a new Songate, handed to Android's installer (ApkProvider); Android asks the first time -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <!-- an app's menu on the Apps page: Uninstall (Android's own question; without this it is never asked) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- the home screen's list of apps (SongateActivity.apps): the ones a launcher shows -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <!-- The HiBy R4 on the user's own ROM: its settings service (Settings › Sound & DAC, Appearance › Status LED). A normal
         permission, granted at install; on any other device nothing answers and Songate shows none of it -->
    <uses-permission android:name="com.andre.hibyr4.permission.HIBY_SETTINGS" />
    <queries>
        <package android:name="com.andre.hibyr4.service" />
        <provider android:authorities="com.andre.hibyr4.settings" />
    </queries>
    <application android:label="Songate"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Songate"
        android:hardwareAccelerated="true">
        <activity android:name=".SongateActivity"
            android:label="Songate"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="fullUser"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Songate as the home screen (Settings: "Use Songate as the home screen", 2.0.1): off until the switch enables it
             (SongateActivity.homeSet), so Android does not offer Songate as a home app to those who never asked -->
        <activity-alias android:name=".HomeAlias"
            android:targetActivity=".SongateActivity"
            android:label="Songate"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <provider android:name=".ApkProvider"
            android:authorities="io.github.andrythebeast.songate.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service android:name=".SongateService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
